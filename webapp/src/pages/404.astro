---
import '../styles/global.css';

const BASE = '/helia-etat-reseau-data';
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/helia-etat-reseau-data/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page introuvable — Helia NC</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />
    <style>
      body { margin:0; min-height:100dvh; background:#0f1117; color:#e2e8f0; font-family:system-ui,-apple-system,sans-serif; display:flex; align-items:center; justify-content:center; }
      .box { text-align:center; padding:40px 24px; max-width:420px; }
      .code { font-size:4rem; font-weight:800; color:#e5009f; line-height:1; }
      h1 { font-size:1.2rem; color:#f8fafc; margin:12px 0 8px; }
      p { font-size:.85rem; color:#64748b; margin:0 0 24px; }
      .back { display:inline-flex; align-items:center; gap:6px; color:#a5b4fc; font-size:.85rem; text-decoration:none; border:1px solid #6366f155; padding:8px 18px; border-radius:20px; transition:border-color .15s; }
      .back:hover { border-color:#6366f1; }
      #redirect-msg { font-size:.8rem; color:#4ade80; margin-bottom:16px; display:none; }
    </style>
    <script define:vars={{ BASE }}>
      // Redirect /commune/noumea/ → /commune/NOUMEA/ (case-insensitive)
      const path = window.location.pathname;
      const communeMatch = path.match(new RegExp(`^${BASE}/commune/([^/]+)(/.*)?$`, 'i'));
      if (communeMatch) {
        const raw = communeMatch[1];
        const upper = decodeURIComponent(raw).toUpperCase();
        const rest = communeMatch[2] ?? '/';
        const target = `${BASE}/commune/${encodeURIComponent(upper)}${rest}`;
        if (decodeURIComponent(raw) !== upper) {
          window.location.replace(target);
        }
      }
    </script>
  </head>
  <body>
    <div class="box">
      <div class="code">404</div>
      <h1>Page introuvable</h1>
      <p>La page demandée n'existe pas ou a été déplacée.</p>
      <div id="redirect-msg"><i class="fa-solid fa-rotate-right"></i> Redirection en cours…</div>
      <a href="/helia-etat-reseau-data/" class="back">
        <i class="fa-solid fa-arrow-left"></i> Retour à la carte
      </a>
    </div>
  </body>
</html>
