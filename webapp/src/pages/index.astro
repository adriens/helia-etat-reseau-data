           class="text-slate-400 hover:text-emerald-400 px-2 py-1 rounded border border-[#2d3148] hover:border-emerald-500 transition-colors">
          <i class="fa-solid fa-sitemap"></i> Sitemap
        </a>
        <a href="https://github.com/adriens/helia-etat-reseau-data" target="_blank" rel="noopener"
           class="text-slate-400 hover:text-violet-400 px-2 py-1 rounded border border-[#2d3148] hover:border-violet-500 transition-colors">
          <i class="fa-brands fa-github"></i> Data
        </a>
