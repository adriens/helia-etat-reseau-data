    </header>

    {lastRefresh && (
      <div class="flex items-center gap-2 px-4 py-1.5 bg-[#13151f] border-b border-[#2d3148] text-xs text-slate-500 shrink-0">
        <i class="fa-solid fa-rotate text-[#4c3f8a]"></i>
        <span>Dernière synchro&nbsp;: <span class="text-slate-400">{lastRefresh}</span></span>
        <span class="text-[#2d3148]">·</span>
        <i class="fa-regular fa-clock text-[#4c3f8a]"></i>
        <span>Prochain refresh&nbsp;: <span class="text-slate-400" id="next-refresh">—</span></span>
