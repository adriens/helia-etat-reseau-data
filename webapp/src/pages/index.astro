---
import '../styles/global.css';
import { readdir, readFile } from 'fs/promises';
import { resolve } from 'path';
import { execSync } from 'child_process';

// Lecture des JSONs au build time depuis data/active/
const dataDir = resolve(process.cwd(), '../data/active');
const files = await readdir(dataDir).catch(() => []);
const maintenances = await Promise.all(
  files
    .filter(f => f.endsWith('.json'))
    .map(async f => JSON.parse(await readFile(resolve(dataDir, f), 'utf-8')))
);
maintenances.sort((a, b) => a.timestamp_debut.localeCompare(b.timestamp_debut));

const builtAt = new Date().toLocaleString('fr-NC', {
  timeZone: 'Pacific/Noumea',
  day: '2-digit', month: 'short', year: 'numeric',
  hour: '2-digit', minute: '2-digit',
});

const commitSha = execSync('git rev-parse --short HEAD', { cwd: resolve(process.cwd(), '..') })
  .toString().trim();
const gitTag = execSync('git describe --tags --abbrev=0 2>/dev/null || echo ""', { cwd: resolve(process.cwd(), '..') })
  .toString().trim();

const lastScrapedAt = maintenances.length
  ? maintenances.reduce((max, m) => m.scraped_at > max ? m.scraped_at : max, maintenances[0].scraped_at)
  : null;
const lastRefresh = lastScrapedAt
  ? new Date(lastScrapedAt).toLocaleString('fr-NC', { timeZone:'Pacific/Noumea', weekday:'short', day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' })
  : null;

// Population municipale — recensement ISEE 2019
// Source : data.gouv.nc/explore/dataset/population-legale-de-la-nouvelle-caledonie
const COMMUNE_POPULATION: Record<string, number> = {
  BELEP: 867, BOULOUPARIS: 3315, BOURAIL: 5531, CANALA: 3701,
  DUMBEA: 35873, FARINO: 712, HIENGHENE: 2454, HOUAILOU: 3955,
  "ILE DES PINS": 2037, "KAALA-GOMEN": 1803, KONE: 8144, KOUAOUA: 1304,
  KOUMAC: 3981, "LA FOA": 3552, LIFOU: 9195, MARE: 5757, MOINDOU: 681,
  "MONT-DORE": 27620, NOUMEA: 94285, OUEGOA: 2118, OUVEA: 3401,
  PAITA: 24563, POINDIMIE: 5006, PONERIHOUEN: 2420, POUEBO: 2144,
  POUEMBOUT: 2752, POUM: 1435, POYA: 2802, SARRAMEA: 572,
  THIO: 2524, TOUHO: 2380, VOH: 2856, YATE: 1667,
};

---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/helia-etat-reseau-data/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
    <meta name="generator" content={Astro.generator} />
    <title>Helia NC — Maintenances réseau</title>
    <meta name="description" content="Carte des maintenances programmées sur le réseau Helia by OPT-NC en Nouvelle-Calédonie." />
    <link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />
    <script is:inline src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.min.js"></script>
    <style>
      body { margin: 0; height: 100dvh; display: flex; flex-direction: column; background: #0f1117; color: #e2e8f0; font-family: system-ui,-apple-system,sans-serif; touch-action: none; }
      .layout { display: flex; flex: 1; overflow: hidden; touch-action: none; }
      aside { width: 340px; flex-shrink: 0; display: flex; flex-direction: column; background: #13151f; border-right: 1px solid #2d3148; overflow: hidden; transition: width .25s ease, height .25s ease, opacity .2s ease; }
      aside.collapsed { width: 0 !important; min-width: 0; opacity: 0; border: none; }
      .filters { padding: 12px; border-bottom: 1px solid #2d3148; display: flex; flex-direction: column; gap: 8px; }
      .filters label { font-size: .7rem; color: #64748b; text-transform: uppercase; letter-spacing: .05em; }
      .filters select, .filters input { width: 100%; background: #1a1d27; border: 1px solid #2d3148; color: #e2e8f0; padding: 6px 8px; border-radius: 6px; font-size: .8rem; }
      .filters select:focus, .filters input:focus { outline: none; border-color: #a78bfa; }
      .btn { width: 100%; padding: 7px 12px; border-radius: 6px; border: none; font-size: .8rem; cursor: pointer; font-weight: 500; transition: opacity .15s; }
      .btn:hover { opacity: .85; }
      .btn-primary { background: #7c3aed; color: #fff; }
      .btn-secondary { background: #1e2235; border: 1px solid #2d3148; color: #94a3b8; }
      .btn-tour { background: #1a1535; border: 1px solid #4c3f8a; color: #a78bfa; }
      .btn-tour.running { background: #2d1f69; border-color: #7c3aed; color: #c4b5fd; animation: tour-glow 1.8s ease-in-out infinite; }
      @keyframes tour-glow { 0%,100% { box-shadow: 0 0 0 0 #7c3aed44; } 50% { box-shadow: 0 0 0 4px #7c3aed22; } }
      .tour-progress { position: absolute; bottom: 0; left: 4px; right: 0; height: 3px; overflow: hidden; border-radius: 0 0 10px 0; background: #1e1535; }
      .tour-progress-bar { height: 100%; width: 0; background: linear-gradient(90deg, #6d28d9, #a78bfa); border-radius: 2px; }
      .list-header { padding: 10px 12px; font-size: .7rem; color: #64748b; text-transform: uppercase; letter-spacing: .05em; border-bottom: 1px solid #2d3148; display: flex; align-items: center; gap: 6px; }
      .count-badge { background: #2d3148; color: #94a3b8; padding: 1px 6px; border-radius: 10px; font-size: .7rem; }
      .maintenance-list { flex: 1; overflow-y: auto; scrollbar-width: thin; scrollbar-color: #2d3148 transparent; padding: 8px; display: flex; flex-direction: column; gap: 10px; }
      .mi { border-radius: 10px; border: 1px solid #2a2e45; background: #181b28; cursor: pointer; transition: border-color .15s, background .15s; position: relative; overflow: hidden; box-shadow: 0 2px 6px rgba(0,0,0,.45); }
      .mi::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--accent, #475569); }
      .mi:hover   { background: #1e2235; border-color: #3d4263; }
      .mi.active  { background: #1a1535; border-color: #6d28d9; }
      .mi.active::before { background: #7c3aed; }
      @keyframes tour-card-glow { 0%,100% { box-shadow: 0 0 0 2px #e5009f, 0 0 18px #e5009f66; } 50% { box-shadow: 0 0 0 2px #e5009f, 0 0 36px #e5009faa; } }
      .mi.tour-active { border-color: #e5009f !important; background: #2a0820 !important; animation: tour-card-glow 2s ease-in-out infinite; }
      .mi.tour-active::before { background: #e5009f !important; width: 6px !important; }
      .mi.tour-active .mi-loc { color: #fb7cc2 !important; font-size: .85rem; }
      .mi.tour-active .mi-loc i { color: #e5009f !important; }
      .mi.tour-active .mi-svc { background: #3d0025; border-color: #e5009f88; color: #fbb6df; }
      .mi.tour-active .mi-svc i { color: #e5009f !important; }
      .mi.tour-active .mi-dates { color: #f9a8d4; }
      .mi.tour-active .mi-dates i { color: #e5009f !important; }
      .mi.tour-active .mi-sep { border-color: #e5009f66; }
      .mi.imp-20  { --accent: #f97316; }
      .mi.imp-30  { --accent: #ef4444; }
      .mi.imp-ad  { --accent: #eab308; }
      .mi.ongoing { border-color: #7f1d1d !important; }
      .mi.ongoing::before { background: #ef4444 !important; animation: ongoing-bar 1.8s ease-in-out infinite; }
