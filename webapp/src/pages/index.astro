      .mi-impact { display: inline-flex; align-items: center; gap: 5px; font-size: .65rem; font-weight: 700; letter-spacing: .03em; padding: 2px 8px; border-radius: 20px; text-transform: uppercase; }
      .mi-impact.imp-20 { background:#431407; border:1px solid #c2410c; color:#fed7aa; }
      .mi-impact.imp-30 { background:#450a0a; border:1px solid #b91c1c; color:#fecaca; }
      .mi-impact.imp-ad { background:#422006; border:1px solid #d97706; color:#fde68a; }
      .mi-head-right { display: flex; align-items: center; gap: 4px; flex-shrink: 0; }
      .mi-duration { font-size: .65rem; font-weight: 600; color: #7c6aad; background: #1a1535; border: 1px solid #2d2060; padding: 2px 7px; border-radius: 20px; }
      .rel-badge { font-size: .6rem; font-weight: 700; padding: 2px 7px; border-radius: 20px; white-space: nowrap; }
      .rel-ongoing  { background: #450a0a; border: 1px solid #b91c1c; color: #fca5a5; animation: ongoing-pulse 1.8s ease-in-out infinite; }
      .rel-today    { background: #1c1917; border: 1px solid #c2410c; color: #fdba74; }
      .rel-tomorrow { background: #1c1917; border: 1px solid #d97706; color: #fde68a; }
      .rel-soon     { background: #1a1d27; border: 1px solid #374151; color: #94a3b8; }
      .rel-later    { background: #1a1d27; border: 1px solid #1e2235; color: #64748b; }
