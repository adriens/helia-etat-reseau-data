          <div class="empty-state">Chargement…</div>
        </div>
        <div class="shortcuts">
          <div class="shortcuts-title">Raccourcis clavier</div>
          <div class="shortcuts-grid">
            <kbd>S</kbd><span>Lancer / arrêter le tour</span>
            <kbd>Espace</kbd><span>Pause / reprendre le tour</span>
            <kbd>F</kbd><span>Plein écran</span>
            <kbd>Echap</kbd><span>Fermer le détail / arrêter le tour</span>
          </div>
        </div>
      </aside>

      <div id="map">
        <canvas id="tour-canvas" style="position:absolute;inset:0;pointer-events:none;display:none;z-index:4;"></canvas>
        <div id="tour-playpause-flash" style="display:none;"></div>
        <button id="btn-fit" title="Cadrer sur les résultats"><i class="fa-solid fa-expand"></i></button>
        <button id="btn-sidebar" title="Masquer/afficher le menu"><i class="fa-solid fa-chevron-left" id="sidebar-chevron"></i></button>
        <button id="btn-fullscreen" title="Plein écran / Quitter le plein écran"><i class="fa-solid fa-maximize" id="fullscreen-icon"></i></button>
        <div id="detail-backdrop"></div>
        <div id="detail">
          <div class="drawer-handle"></div>
          <button class="close-btn" id="detail-close">✕</button>
          <h2 id="detail-title">Maintenance</h2>
          <div id="detail-body"></div>
        </div>
      </div>
    </div>

    <script define:vars={{ maintenances, COMMUNE_POPULATION }}>
      // ── Carte ────────────────────────────────────────────────────────────
      const map = new maplibregl.Map({
        container: "map",
        style: "https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json",
        center: [165.8, -21.2],
        zoom: 6.2,
        attributionControl: false,
      });
      map.addControl(new maplibregl.AttributionControl({ compact: true }), "bottom-left");
      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");
      map.touchZoomRotate.enable();
      map.touchPitch.enable();
      map.getContainer().addEventListener("touchstart", (e) => {
        if (e.touches.length > 1) e.preventDefault();
      }, { passive: false });

      let allMaintenances = maintenances;
      let displayed = [], markers = [];

      function haversineKm(lat1, lon1, lat2, lon2) {
        const R = 6371, toRad = d => d * Math.PI / 180;
        const dLat = toRad(lat2 - lat1), dLon = toRad(lon2 - lon1);
        const a = Math.sin(dLat/2)**2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon/2)**2;
        return R * 2 * Math.asin(Math.sqrt(a));
      }

      // ── Helpers affichage ────────────────────────────────────────────────
      function fmtDate(iso) {
        return new Date(iso).toLocaleString("fr-NC", {
          day: "2-digit", month: "short", year: "numeric",
          hour: "2-digit", minute: "2-digit", timeZone: "Pacific/Noumea",
        });
      }
      const _shortFmt = new Intl.DateTimeFormat("fr-NC", {
        day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit",
        timeZone: "Pacific/Noumea", hour12: false,
      });
      function fmtShort(iso) {
        return _shortFmt.format(new Date(iso)).replace(",", "").replace(":", "h");
      }
      function fmtDuration(min) {
        if (min < 60) return `${min} min`;
        const h = Math.floor(min / 60), r = min % 60;
        return r ? `${h}h${String(r).padStart(2,"0")}` : `${h}h`;
      }
      function normalize(s) {
        return s.toUpperCase().normalize("NFD").replace(/\p{Diacritic}/gu, "");
      }
      function relativeTime(isoStart, isoEnd) {
        const now = Date.now(), start = new Date(isoStart).getTime(), end = new Date(isoEnd).getTime();
        if (now >= start && now <= end) return { label: "En cours", cls: "rel-ongoing" };
        const diffMs = start - now;
        if (diffMs <= 0) return null;
        const diffH = diffMs / 3600000, diffD = diffMs / 86400000;
        if (diffH < 24) return { label: "Aujourd'hui", cls: "rel-today" };
        if (diffD < 2)  return { label: "Demain",      cls: "rel-tomorrow" };
        if (diffD < 3)  return { label: `Dans ${Math.floor(diffD * 24)}h`, cls: "rel-soon" };
        return { label: `Dans ${Math.floor(diffD)} j`, cls: "rel-later" };
      }

      const SVC = {
        TELEPHONIE_FIXE:          { icon: "fa-phone",         label: "Tél. fixe" },
        TELEPHONIE_MOBILE:        { icon: "fa-mobile-screen", label: "Tél. mobile" },
        INTERNET_FIXE:            { icon: "fa-wifi",          label: "Internet fixe" },
        INTERNET_MOBILE:          { icon: "fa-signal",        label: "Internet mobile" },
        RESEAU_CUIVRE:            { icon: "fa-ethernet",      label: "Cuivre" },
        FIBRE_OPTIQUE:            { icon: "fa-circle-dot",    label: "Fibre" },
        LIAISONS_CELERIS_ETHERNET:{ icon: "fa-network-wired", label: "Céléris/Eth." },
      };
      const IMPACT_META = {
        COUPURE_20_30_MIN: { cls: "imp-20", icon: "fa-bolt",            label: "Coupure 20–30 min" },
        COUPURE_30_MIN:    { cls: "imp-30", icon: "fa-bolt",            label: "Coupure 30 min" },
        A_DETERMINER:      { cls: "imp-ad", icon: "fa-circle-question", label: "À déterminer" },
      };

      function applyFilters(data) {
        const service = document.getElementById("filter-service").value;
        return data.filter(m => {
          if (service && !m.services.includes(service)) return false;
          return true;
        });
      }

      // ── Rendu liste ──────────────────────────────────────────────────────
      const listEl      = document.getElementById("maintenance-list");
      const countEl     = document.getElementById("count");
      const detailEl    = document.getElementById("detail");
      const backdropEl  = document.getElementById("detail-backdrop");
      const detailTitle = document.getElementById("detail-title");
      const detailBody  = document.getElementById("detail-body");

      let isInitialRender = true;

      function renderList(data, resetView = false) {
        displayed = data;
        countEl.textContent = `${data.length} / ${allMaintenances.length}`;
        if (!data.length) {
          listEl.innerHTML = '<div class="empty-state"><i class="fa-solid fa-satellite-dish" style="font-size:1.4rem;display:block;margin-bottom:8px;color:#4c3f8a"></i>Aucune maintenance trouvée.</div>';
          clearMarkers();
          return;
        }
        listEl.innerHTML = data.map(m => {
          const im      = IMPACT_META[m.impact] ?? IMPACT_META.A_DETERMINER;
          const rel     = relativeTime(m.timestamp_debut, m.timestamp_fin);
          const ongoing = rel?.cls === "rel-ongoing";
          const communes = m.communes_concernees;
          const locLabel = m.est_toute_nc
            ? "Toute la Nouvelle-Calédonie"
            : communes.length > 4
              ? `${communes.slice(0,4).join(", ")} <span class="more">+${communes.length-4}</span>`
              : communes.join(", ");
          const svcs = m.services.map(s => {
            const sv = SVC[s] ?? { icon: "fa-circle-nodes", label: s.replace(/_/g," ") };
            return `<span class="mi-svc"><i class="fa-solid ${sv.icon}"></i>${sv.label}</span>`;
          }).join("");
          const toutNC   = m.est_toute_nc ? `<span class="mi-svc toute-nc"><i class="fa-solid fa-earth-oceania"></i>Toute NC</span>` : "";
          const relBadge = rel ? `<span class="rel-badge ${rel.cls}">${rel.label}</span>` : "";
          return `
          <div class="mi ${im.cls}${ongoing ? " ongoing" : ""}" data-id="${m.id}">
            <div class="tour-progress"><div class="tour-progress-bar"></div></div>
            <div class="mi-head">
              <span class="mi-impact ${im.cls}"><i class="fa-solid ${im.icon}"></i>${im.label}</span>
              <div class="mi-head-right">
                ${relBadge}
                <span class="mi-duration"><i class="fa-regular fa-clock" style="margin-right:3px"></i>${fmtDuration(m.duree_fenetre_minutes)}</span>
              </div>
            </div>
            <div class="mi-body">
              <div class="mi-dates">
                <i class="fa-regular fa-calendar-days"></i>
                <span>${fmtShort(m.timestamp_debut)}</span>
                <span class="arr">→</span>
                <span>${fmtShort(m.timestamp_fin)}</span>
              </div>
              <div class="mi-loc" title="${communes.join(", ")}">
                <i class="fa-solid fa-location-dot"></i><span>${locLabel}</span>
              </div>
              <hr class="mi-sep">
              <div class="mi-svcs">${svcs}${toutNC}</div>
            </div>
          </div>`;
        }).join("");
        listEl.querySelectorAll(".mi").forEach(el =>
          el.addEventListener("click", () => selectMaintenance(el.dataset.id))
        );
        renderMarkers(data);
        if (!isInitialRender && !resetView) fitToMarkers();
        isInitialRender = false;
      }

      // ── Fit bounds ───────────────────────────────────────────────────────
      function fitToMarkers() {
        if (!markers.length) return;
        const lngs = [], lats = [];
        markers.forEach(({ mapMarker }) => { const ll = mapMarker.getLngLat(); lngs.push(ll.lng); lats.push(ll.lat); });
        if (lngs.length === 1) {
          map.flyTo({ center: [lngs[0], lats[0]], zoom: 9, duration: 600 });
        } else {
          map.fitBounds([[Math.min(...lngs), Math.min(...lats)], [Math.max(...lngs), Math.max(...lats)]], { padding: 60, duration: 600, maxZoom: 10 });
        }
      }
      document.getElementById("btn-fit").addEventListener("click", fitToMarkers);

      // ── Plein écran ───────────────────────────────────────────────────────
      function updateFullscreenBtn() {
        const btn  = document.getElementById("btn-fullscreen");
        const icon = document.getElementById("fullscreen-icon");
        const active = !!document.fullscreenElement;
        btn.classList.toggle("active", active);
        icon.className = active ? "fa-solid fa-compress" : "fa-solid fa-maximize";
        btn.title = active ? "Quitter le plein écran" : "Plein écran";
      }
      document.addEventListener("fullscreenchange", updateFullscreenBtn);
      if (!document.documentElement.requestFullscreen) {
        // iOS Safari ne supporte pas l'API Fullscreen — cacher le bouton
        document.getElementById("btn-fullscreen").style.display = "none";
      } else {
        document.getElementById("btn-fullscreen").addEventListener("click", () => {
          if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(() => {});
          } else {
            document.exitFullscreen().catch(() => {});
          }
        });
      }

      // ── Toggle sidebar ────────────────────────────────────────────────────
      let sidebarVisible = true;
      document.getElementById("btn-sidebar").addEventListener("click", () => {
        sidebarVisible = !sidebarVisible;
        document.querySelector("aside").classList.toggle("collapsed", !sidebarVisible);
        document.getElementById("sidebar-chevron").className =
          sidebarVisible ? "fa-solid fa-chevron-left" : "fa-solid fa-chevron-right";
        setTimeout(() => map.resize(), 260);
      });

      // ── Marqueurs carte ──────────────────────────────────────────────────
      function clearMarkers() { markers.forEach(({ mapMarker }) => mapMarker.remove()); markers = []; }

      function buildPopupHtml(commune, ms) {
        const rows = ms.map(m => {
          const color = m.impact === "COUPURE_30_MIN" ? "#ef4444" : m.impact === "A_DETERMINER" ? "#eab308" : "#f97316";
          const svcs = m.services.map(s => SVC[s]?.label ?? s.replace(/_/g," ")).join(" · ");
          return `<div class="hp-row">
            <div class="hp-dot" style="background:${color};box-shadow:0 0 4px ${color}99"></div>
            <div class="hp-content">
              <div class="hp-dates">${fmtShort(m.timestamp_debut)} → ${fmtShort(m.timestamp_fin)}</div>
              <div class="hp-svcs">${svcs}</div>
            </div></div>`;
        }).join("");
        return `<div style="min-width:200px">
          <div class="hp-head"><span class="hp-commune">📍 ${commune}</span><span class="hp-count">${ms.length} maint.</span></div>
          <div class="hp-body">${rows}</div>
          <div class="hp-footer">Cliquer pour le détail</div>
        </div>`;
      }

      function renderMarkers(data) {
        clearMarkers();
        const byCommune = new Map();
        data.forEach(m => {
          m.communes_geopoints.forEach(({ commune, lat, lon }) => {
            if (!byCommune.has(commune)) byCommune.set(commune, { lat, lon, ms: [] });
            byCommune.get(commune).ms.push(m);
          });
        });
        byCommune.forEach(({ lat, lon, ms }, commune) => {
          const hasRed    = ms.some(m => m.impact === "COUPURE_30_MIN");
          const hasOrange = ms.some(m => m.impact === "COUPURE_20_30_MIN");
          const dotColor  = hasRed ? "#ef4444" : hasOrange ? "#f97316" : "#38bdf8";
          const ringColor = hasRed ? "#fca5a5" : hasOrange ? "#fed7aa" : "#bae6fd";
          // Taille log-proportionnelle à la population (min 9px / max 26px)
          const pop     = COMMUNE_POPULATION[commune] ?? 1000;
          const dotSize = Math.round(9 + 17 * Math.log(pop / 572) / Math.log(94285 / 572));
          const wrapper = document.createElement("div");
          Object.assign(wrapper.style, { width:"36px", height:"36px", display:"flex", alignItems:"center", justifyContent:"center", cursor:"pointer" });
          const dot = document.createElement("div");
          Object.assign(dot.style, { width:`${dotSize}px`, height:`${dotSize}px`, background:dotColor, border:`2px solid ${ringColor}`, borderRadius:"50%", transition:"width .2s, height .2s, border-width .2s", boxShadow:`0 0 8px ${dotColor}aa` });
          wrapper.appendChild(dot);
          const popup = new maplibregl.Popup({ closeButton:false, closeOnClick:false, offset:14, className:"helia-popup", maxWidth:"260px" })
            .setLngLat([lon, lat]).setHTML(buildPopupHtml(commune, ms));
          let hideTimer = null;
          wrapper.addEventListener("mouseenter", () => { clearTimeout(hideTimer); dot.style.transform="scale(1.6)"; popup.addTo(map); });
          wrapper.addEventListener("mouseleave", () => { hideTimer = setTimeout(() => { dot.style.transform="scale(1)"; popup.remove(); }, 150); });
          wrapper.addEventListener("click", () => {
            const target = ms.slice().sort((a,b) => a.timestamp_debut.localeCompare(b.timestamp_debut))[0];
            selectMaintenance(target.id, commune);
          });
          const mapMarker = new maplibregl.Marker({ element:wrapper, anchor:"center" }).setLngLat([lon, lat]).addTo(map);
          markers.push({ mapMarker, dot, ids: new Set(ms.map(m => m.id)), commune });
        });
      }

      // ── Sélection / Détail ───────────────────────────────────────────────
      const PROVINCE_LABEL = { PROVINCE_SUD: "Province Sud", PROVINCE_NORD: "Province Nord", ILES_LOYAUTE: "Îles Loyauté" };

      function fmtCoupure(m) {
        if (m.duree_coupure_min_minutes == null) return "À déterminer";
        if (m.duree_coupure_min_minutes === m.duree_coupure_max_minutes) return `${m.duree_coupure_min_minutes} min`;
        return `${m.duree_coupure_min_minutes}–${m.duree_coupure_max_minutes} min`;
      }

      function renderDetail(m) {
        const im        = IMPACT_META[m.impact] ?? IMPACT_META.A_DETERMINER;
        const communes  = m.communes_concernees;
        const provinces = m.provinces_concernees.map(p => PROVINCE_LABEL[p] ?? p);
        const services  = m.services.map(s => SVC[s]?.label ?? s.replace(/_/g," "));
        const communesPills = m.est_toute_nc
          ? `<span class="detail-pill pill-nc"><i class="fa-solid fa-earth-oceania"></i> Toute la Nouvelle-Calédonie</span>`
          : communes.map(c => {
              const pop = COMMUNE_POPULATION[c];
              const popHtml = pop ? `<span class="detail-pill-pop">${pop.toLocaleString('fr-FR')} hab.</span>` : "";
              return `<span class="detail-pill">${c}${popHtml}</span>`;
            }).join("");
        detailTitle.innerHTML = `
          <span class="detail-id">#${m.id}</span>
          <span class="detail-impact-badge ${im.cls}"><i class="fa-solid ${im.icon}"></i> ${im.label}</span>`;
        detailBody.innerHTML = `
          <div class="detail-section">
            <div class="detail-row"><span class="detail-label"><i class="fa-regular fa-calendar-days"></i> Début</span><span class="detail-value">${fmtDate(m.timestamp_debut)}</span></div>
            <div class="detail-row"><span class="detail-label"><i class="fa-regular fa-calendar-check"></i> Fin</span><span class="detail-value">${fmtDate(m.timestamp_fin)}</span></div>
            <div class="detail-row"><span class="detail-label"><i class="fa-regular fa-clock"></i> Fenêtre</span><span class="detail-value">${fmtDuration(m.duree_fenetre_minutes)}</span></div>
            <div class="detail-row"><span class="detail-label"><i class="fa-solid fa-bolt"></i> Coupure</span><span class="detail-value">${fmtCoupure(m)}</span></div>
          </div>
          <div class="detail-section">
            <div class="detail-section-title"><i class="fa-solid fa-location-dot"></i> Communes concernées (${communes.length})</div>
            <div class="detail-pills">${communesPills}</div>
          </div>
          <div class="detail-section">
            <div class="detail-section-title"><i class="fa-solid fa-network-wired"></i> Services</div>
            <div class="detail-pills">${services.map(s => `<span class="detail-pill pill-svc">${s}</span>`).join("")}</div>
          </div>
          <div class="detail-section">
            <div class="detail-section-title"><i class="fa-solid fa-map"></i> Provinces</div>
            <div class="detail-pills">${provinces.map(p => `<span class="detail-pill pill-province">${p}</span>`).join("")}</div>
          </div>
          <div class="detail-footer">Scrape · ${fmtDate(m.scraped_at_local)}</div>`;
      }

      function openDetail(m) {
        renderDetail(m);
        detailEl.classList.add("visible");
        backdropEl.classList.add("visible");
      }
      function closeDetail() {
        detailEl.classList.remove("visible");
        backdropEl.classList.remove("visible");
        listEl.querySelectorAll(".mi").forEach(el => el.classList.remove("active"));
        markers.forEach(({ dot }) => { dot.style.width="14px"; dot.style.height="14px"; dot.style.borderWidth="2px"; dot.style.animation=""; });
      }

      function selectMaintenance(id, focusCommune = null, fromTour = false) {
        if (!fromTour) stopTour();
        listEl.querySelectorAll(".mi").forEach(el => {
          el.classList.toggle("active", el.dataset.id === id);
          el.classList.remove("tour-active");
        });
        const activeEl = listEl.querySelector(`.mi[data-id="${id}"]`);
        if (fromTour && activeEl) activeEl.classList.add("tour-active");
        if (activeEl) activeEl.scrollIntoView({ behavior:"smooth", block:"nearest" });
        markers.forEach(({ dot, ids, commune }) => {
          const selected = focusCommune ? commune === focusCommune : ids.has(id);
          dot.style.width = selected ? "26px" : "14px"; dot.style.height = selected ? "26px" : "14px";
          dot.style.borderWidth = selected ? "3px" : "2px"; dot.style.animation = selected ? "dot-ping 1.4s ease-out infinite" : "";
        });
        const m = displayed.find(x => x.id === id);
        if (!m) return;
        if (!fromTour) openDetail(m);
        if (!fromTour) {
          const gp = focusCommune ? m.communes_geopoints.find(g => g.commune === focusCommune) : m.communes_geopoints[0];
          if (gp) map.flyTo({ center:[gp.lon, gp.lat], zoom:9, duration:800 });
        }
      }

      document.getElementById("detail-close").addEventListener("click", closeDetail);
      backdropEl.addEventListener("click", closeDetail);
      function toggleFullscreen() {
        if (!document.fullscreenElement) {
          document.documentElement.requestFullscreen().catch(() => {});
          if (sidebarVisible) document.getElementById("btn-sidebar").click();
        } else {
          document.exitFullscreen().catch(() => {});
          if (!sidebarVisible) document.getElementById("btn-sidebar").click();
        }
      }

      document.addEventListener("keydown", (e) => {
        const tag = document.activeElement?.tagName;
        if (tag === "INPUT" || tag === "SELECT" || tag === "TEXTAREA") return;
        if (e.key === "Escape") { closeDetail(); stopTour(); }
        if (e.code === "Space" && tourRunning) { e.preventDefault(); togglePause(); }
        if (e.key === "f" || e.key === "F") { e.preventDefault(); toggleFullscreen(); }
        if (e.key === "s" || e.key === "S") { e.preventDefault(); if (tourRunning) stopTour(); else startTour(); }
      });

      // ── Three.js arc overlay ──────────────────────────────────────────────
      let _ctx = null, _arcAnimId = null, _pingAnimId = null, _prevTourGp = null;

      const ARC_COLORS_CSS = {
        COUPURE_30_MIN:    '#e5009f',
        COUPURE_20_30_MIN: '#e5009f',
        A_DETERMINER:      '#e5009f',
      };

      function _initOverlay() {
        const cvs   = document.getElementById('tour-canvas');
        const mapEl = document.getElementById('map');
        const dpr   = devicePixelRatio || 1;
        const w = mapEl.clientWidth, h = mapEl.clientHeight;
        cvs.width  = w * dpr; cvs.height = h * dpr;
        cvs.style.width = w + 'px'; cvs.style.height = h + 'px';
        _ctx = cvs.getContext('2d');
        window.addEventListener('resize', () => {
          const ww = mapEl.clientWidth, hh = mapEl.clientHeight;
          cvs.width  = ww * dpr; cvs.height = hh * dpr;
          cvs.style.width = ww + 'px'; cvs.style.height = hh + 'px';
        });
      }

      function _bezier(a, ctrl, b, t) {
        const u = 1 - t;
        return { x: u*u*a.x + 2*u*t*ctrl.x + t*t*b.x, y: u*u*a.y + 2*u*t*ctrl.y + t*t*b.y };
      }

      function _showCanvas() { document.getElementById('tour-canvas').style.display = 'block'; }
      function _hideCanvas() {
        cancelAnimationFrame(_arcAnimId); _arcAnimId = null;
        cancelAnimationFrame(_pingAnimId); _pingAnimId = null;
        if (_ctx) _ctx.clearRect(0, 0, _ctx.canvas.width, _ctx.canvas.height);
        document.getElementById('tour-canvas').style.display = 'none';
        _prevTourGp = null;
      }

      function animateTourArc(fromGp, toGp, impact) {
        if (!_ctx) return;
        cancelAnimationFrame(_arcAnimId);
        const color = ARC_COLORS_CSS[impact] ?? ARC_COLORS_CSS.A_DETERMINER;
        const N = 120, t0 = performance.now();
        const sparks = []; // particle system

        function spawnSparks(x, y, n) {
          for (let i = 0; i < n; i++) {
            const a = Math.random() * Math.PI * 2;
            const s = 0.4 + Math.random() * 2.2;
            sparks.push({ x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s - 0.6,
                          life: 1, decay: 0.04 + Math.random() * 0.05,
                          r: 0.8 + Math.random() * 1.8 });
          }
        }

        function frame() {
          const dpr  = devicePixelRatio || 1;
          const now  = performance.now();
          const t    = Math.min((now - t0) / TOUR_FLY_MS, 1);
          const pA   = map.project([fromGp.lon, fromGp.lat]);
          const pB   = map.project([toGp.lon,   toGp.lat]);
          const lift = Math.min(Math.hypot(pB.x - pA.x, pB.y - pA.y) * 0.45, 220);
          const ctrl = { x: (pA.x + pB.x) / 2, y: (pA.y + pB.y) / 2 - lift };
          const drawn = Math.max(1, Math.floor(t * N));
          const tip   = _bezier(pA, ctrl, pB, t);

          // Spawn sparks at tip
          if (t < 1) {
            if (Math.random() < 0.75) spawnSparks(tip.x, tip.y, 1);
            if (Math.random() < 0.20) spawnSparks(tip.x, tip.y, 3);
          }

          _ctx.clearRect(0, 0, _ctx.canvas.width, _ctx.canvas.height);
          _ctx.save();
          _ctx.scale(dpr, dpr);
          _ctx.lineCap = 'round';

          // ── QUEUE ────────────────────────────────────────────────────────────
          const TAIL_LEN  = 48;
          const tailEnd   = drawn;
          const tailStart = Math.max(0, tailEnd - TAIL_LEN);

          // Pass 0 — nébuleuse ultra-large (halo extérieur doux)
          _ctx.lineWidth = 20;
          for (let i = tailStart; i < tailEnd; i++) {
            const f   = (i - tailStart) / TAIL_LEN;
            const pt1 = _bezier(pA, ctrl, pB, i / N);
            const pt2 = _bezier(pA, ctrl, pB, (i + 1) / N);
            _ctx.globalAlpha = 0.015 + 0.055 * f;
            _ctx.shadowBlur  = 40 + 35 * f;
            _ctx.shadowColor = color;
            _ctx.strokeStyle = color;
            _ctx.beginPath(); _ctx.moveTo(pt1.x, pt1.y); _ctx.lineTo(pt2.x, pt2.y); _ctx.stroke();
          }
          _ctx.shadowBlur = 0;

          // Pass 1 — halo coloré intermédiaire
          _ctx.lineWidth = 7;
          for (let i = tailStart; i < tailEnd; i++) {
            const f   = (i - tailStart) / TAIL_LEN;
            const pt1 = _bezier(pA, ctrl, pB, i / N);
            const pt2 = _bezier(pA, ctrl, pB, (i + 1) / N);
            _ctx.globalAlpha = 0.05 + 0.20 * f;
            _ctx.shadowBlur  = 16 + 22 * f;
            _ctx.shadowColor = color;
            _ctx.strokeStyle = color;
            _ctx.beginPath(); _ctx.moveTo(pt1.x, pt1.y); _ctx.lineTo(pt2.x, pt2.y); _ctx.stroke();
          }
          _ctx.shadowBlur = 0;

          // Pass 2 — cœur fin et brillant (blanc-chaud en tête)
          _ctx.lineWidth = 2.5;
          for (let i = tailStart; i < tailEnd; i++) {
            const f   = (i - tailStart) / TAIL_LEN;
            const pt1 = _bezier(pA, ctrl, pB, i / N);
            const pt2 = _bezier(pA, ctrl, pB, (i + 1) / N);
            _ctx.globalAlpha = 0.04 + 0.96 * f;
            _ctx.strokeStyle = f > 0.80 ? '#ffffff' : color;
            _ctx.beginPath(); _ctx.moveTo(pt1.x, pt1.y); _ctx.lineTo(pt2.x, pt2.y); _ctx.stroke();
          }

          // ── PARTICULES / ÉTINCELLES ───────────────────────────────────────────
          for (let i = sparks.length - 1; i >= 0; i--) {
            const p = sparks[i];
            p.x += p.vx; p.y += p.vy; p.vy += 0.04; // micro gravité
            p.life -= p.decay;
            if (p.life <= 0) { sparks.splice(i, 1); continue; }
            _ctx.save();
            _ctx.globalAlpha = p.life * 0.85;
            _ctx.shadowBlur  = 8; _ctx.shadowColor = color;
            _ctx.fillStyle   = p.life > 0.55 ? '#ffffff' : color;
            _ctx.beginPath(); _ctx.arc(p.x, p.y, p.r * p.life, 0, Math.PI * 2); _ctx.fill();
            _ctx.shadowBlur = 0; _ctx.restore();
          }

          // ── NOYAU (tête pulsante) ─────────────────────────────────────────────
          const pulse = 0.5 + 0.5 * Math.sin(now / 75);

          // Couronne externe large — respire
          _ctx.save();
          _ctx.shadowBlur = 55 + 25 * pulse; _ctx.shadowColor = color;
          _ctx.globalAlpha = 0.45 + 0.2 * pulse; _ctx.fillStyle = color;
          _ctx.beginPath(); _ctx.arc(tip.x, tip.y, 11 + 4 * pulse, 0, Math.PI * 2); _ctx.fill();
          _ctx.shadowBlur = 0; _ctx.restore();

          // Couronne interne — teinte blanc-rose
          _ctx.save();
          _ctx.shadowBlur = 28; _ctx.shadowColor = '#ffffff';
          _ctx.globalAlpha = 0.75; _ctx.fillStyle = '#ffd6f0';
          _ctx.beginPath(); _ctx.arc(tip.x, tip.y, 5.5, 0, Math.PI * 2); _ctx.fill();
          _ctx.shadowBlur = 0; _ctx.restore();

          // Point blanc central
          _ctx.save();
          _ctx.shadowBlur = 14; _ctx.shadowColor = '#ffffff';
          _ctx.globalAlpha = 1; _ctx.fillStyle = '#ffffff';
          _ctx.beginPath(); _ctx.arc(tip.x, tip.y, 2.8, 0, Math.PI * 2); _ctx.fill();
          _ctx.shadowBlur = 0; _ctx.restore();

          // ── BLOOM D'IMPACT (t > 0.48) ─────────────────────────────────────────
          if (t > 0.48) {
            const flash  = (t - 0.48) / 0.52;
            const eased  = 1 - Math.pow(1 - flash, 2); // ease-out
            _ctx.save();

            // Anneau de choc 1
            _ctx.globalAlpha = (1 - eased) * 0.55;
            _ctx.strokeStyle = color; _ctx.lineWidth = 2.5;
            _ctx.shadowBlur = 18 * (1 - eased); _ctx.shadowColor = color;
            _ctx.beginPath(); _ctx.arc(tip.x, tip.y, 90 * eased, 0, Math.PI * 2); _ctx.stroke();

            // Anneau de choc 2 (décalé)
            if (flash > 0.25) {
              const f2 = (flash - 0.25) / 0.75;
              _ctx.globalAlpha = (1 - f2) * 0.35;
              _ctx.lineWidth = 1.5;
              _ctx.beginPath(); _ctx.arc(tip.x, tip.y, 140 * f2, 0, Math.PI * 2); _ctx.stroke();
            }

            // Halo d'impact central
            _ctx.shadowBlur = 90 * eased; _ctx.shadowColor = color;
            _ctx.globalAlpha = 0.25 * eased; _ctx.fillStyle = color;
            _ctx.beginPath(); _ctx.arc(tip.x, tip.y, 55 * eased, 0, Math.PI * 2); _ctx.fill();

            // Flash blanc au cœur
            _ctx.shadowBlur = 40 * eased; _ctx.shadowColor = '#ffffff';
            _ctx.globalAlpha = 0.6 * eased; _ctx.fillStyle = '#ffffff';
            _ctx.beginPath(); _ctx.arc(tip.x, tip.y, 18 * eased, 0, Math.PI * 2); _ctx.fill();

            _ctx.shadowBlur = 0; _ctx.restore();
          }

          _ctx.restore();
          if (t < 1) _arcAnimId = requestAnimationFrame(frame);
        }
        _arcAnimId = requestAnimationFrame(frame);
      }

      function stopPing() {
        cancelAnimationFrame(_pingAnimId); _pingAnimId = null;
      }

      function animatePing(gp, impact) {
        if (!_ctx) return;
        stopPing();
        const color      = ARC_COLORS_CSS[impact] ?? ARC_COLORS_CSS.A_DETERMINER;
        const PING_CYCLE = 1600, MAX_RADIUS = 90, NUM_RINGS = 3;
        const t0         = performance.now();

        function frame() {
          const dpr     = devicePixelRatio || 1;
          const elapsed = performance.now() - t0;
          const p       = map.project([gp.lon, gp.lat]);

          _ctx.clearRect(0, 0, _ctx.canvas.width, _ctx.canvas.height);
          _ctx.save();
          _ctx.scale(dpr, dpr);

          // Bloom: halo qui respire (sinusoïde ~1.4 s)
          const breath = 0.5 + 0.5 * Math.sin(elapsed / 700 * Math.PI);
          _ctx.save();
          _ctx.shadowBlur  = 28 + 18 * breath;
          _ctx.shadowColor = color;
          _ctx.globalAlpha = 0.22 + 0.12 * breath;
          _ctx.fillStyle   = color;
          _ctx.beginPath(); _ctx.arc(p.x, p.y, 16 + 6 * breath, 0, Math.PI * 2); _ctx.fill();
          _ctx.shadowBlur  = 0;
          _ctx.restore();

          // Ping rings
          for (let i = 0; i < NUM_RINGS; i++) {
            const t      = ((elapsed / PING_CYCLE) - i / NUM_RINGS + 10) % 1;
            _ctx.globalAlpha = Math.max(0, (1 - t) * 0.75);
            _ctx.strokeStyle = color; _ctx.lineWidth = 2;
            _ctx.beginPath(); _ctx.arc(p.x, p.y, t * MAX_RADIUS, 0, Math.PI * 2); _ctx.stroke();
          }

          // Center dot (légère lueur blanche)
          _ctx.save();
          _ctx.shadowBlur  = 8;
          _ctx.shadowColor = '#ffffff';
          _ctx.globalAlpha = 0.9; _ctx.fillStyle = '#ffffff';
          _ctx.beginPath(); _ctx.arc(p.x, p.y, 6, 0, Math.PI * 2); _ctx.fill();
          _ctx.shadowBlur  = 0;
          _ctx.restore();

          _ctx.restore();

          _pingAnimId = requestAnimationFrame(frame);
        }
        _pingAnimId = requestAnimationFrame(frame);
      }

      // ── Tour des maintenances ─────────────────────────────────────────────
      let tourTimeout = null, tourRunning = false, tourPaused = false, tourIndex = 0, tourActivePopup = null, tourItems = [], tourCollapsedSidebar = false;
      const TOUR_DELAY   = 6000;
      const TOUR_FLY_MS  = 2000;
      const TOUR_BEARINGS = [-20, 20, -35, 10, 35, -10, 0, 25, -25, 15];

      function updateTourBtn() {
        const btn = document.getElementById("btn-tour");
        if (tourRunning) {
          const icon = tourPaused ? 'fa-play' : 'fa-pause';
          const label = tourPaused ? 'En pause' : `Tour ${tourIndex} / ${tourItems.length}`;
          btn.innerHTML = `<i class="fa-solid fa-stop"></i> ${label} <i class="fa-solid ${icon}" style="margin-left:4px;opacity:.7;font-size:.8em"></i>`;
          btn.classList.add("running");
        } else {
          btn.innerHTML = `<i class="fa-solid fa-route"></i> Tour des maintenances`;
          btn.classList.remove("running");
        }
      }

      let _ppfTimer = null;
      function showPlayPauseFlash(icon) {
        const el = document.getElementById('tour-playpause-flash');
        el.innerHTML = `<div class="ppf-ring"><i class="fa-solid ${icon}"></i></div>`;
        el.style.display = 'flex';
        el.className = 'show';
        clearTimeout(_ppfTimer);
        _ppfTimer = setTimeout(() => {
          el.className = 'hide';
          setTimeout(() => { el.style.display = 'none'; el.className = ''; }, 360);
        }, 600);
      }

      function togglePause() {
        if (!tourRunning) return;
        if (tourPaused) {
          tourPaused = false;
          showPlayPauseFlash('fa-play');
          tourStep();
        } else {
          tourPaused = true;
          showPlayPauseFlash('fa-pause');
          clearTimeout(tourTimeout);
          tourTimeout = null;
          // Geler la barre de progression
          const activeEl = listEl.querySelector('.mi.tour-active');
          if (activeEl) {
            const bar = activeEl.querySelector('.tour-progress-bar');
            if (bar) {
              const w = getComputedStyle(bar).width;
              bar.style.transition = 'none';
              bar.style.width = w;
            }
          }
        }
        updateTourBtn();
      }

      function startTourProgressBar(id) {
        const el = listEl.querySelector(`.mi[data-id="${id}"]`);
        if (!el) return;
        const bar = el.querySelector(".tour-progress-bar");
        if (!bar) return;
        bar.style.transition = "none";
        bar.style.width = "0%";
        bar.offsetHeight;
        bar.style.transition = `width ${TOUR_DELAY}ms linear`;
        bar.style.width = "100%";
      }

      function hideTourPopup() {
        if (tourActivePopup) { tourActivePopup.remove(); tourActivePopup = null; }
      }

      // Téléphone = écran tactile avec viewport height < 520px en paysage
      // (téléphones ~375-430px, tablettes ~768px+)
      function isPhone() {
        return ('ontouchstart' in window || navigator.maxTouchPoints > 0) &&
               window.innerHeight < 520;
      }

      function showTourPopup(m, gp) {
        if (!tourRunning || !gp) return;
        if (isPhone()) return;
        hideTourPopup();
        const im   = IMPACT_META[m.impact] ?? IMPACT_META.A_DETERMINER;
        const svcs = m.services.map(s => {
          const sv = SVC[s] ?? { icon: 'fa-circle-nodes', label: s.replace(/_/g,' ') };
          return `<span class="tp-svc"><i class="fa-solid ${sv.icon}"></i>${sv.label}</span>`;
        }).join('');
        const pop  = gp.population ?? COMMUNE_POPULATION[gp.commune];
        const popHtml = pop != null
          ? `<span class="tp-pop"><i class="fa-solid fa-people-group"></i>${pop.toLocaleString('fr-FR')} hab.</span>`
          : '';
        const now = Date.now();
        const tDebut = m.timestamp_debut ? new Date(m.timestamp_debut).getTime() : null;
        const tFin   = m.timestamp_fin   ? new Date(m.timestamp_fin).getTime()   : null;
        let pct = 0;
        if (tDebut && tFin && tFin > tDebut) {
          if (now >= tFin) pct = 100;
          else if (now >= tDebut) pct = Math.round((now - tDebut) / (tFin - tDebut) * 100);
        }
        const progressHtml = (tDebut && tFin)
          ? `<div class="tp-progress-wrap">
               <div class="tp-progress-bar-track"><div class="tp-progress-bar-fill ${im.cls}" style="width:${pct}%"></div></div>
               <div class="tp-progress-label">${pct}% écoulé</div>
             </div>`
          : '';
        const html = `<div class="tp">
          <div class="tp-commune"><i class="fa-solid fa-location-dot"></i><a class="tp-commune-link" href="/helia-etat-reseau-data/commune/${encodeURIComponent(gp.commune)}/" target="_blank">${gp.commune}</a>${popHtml}</div>
          <div class="tp-svcs">${svcs}</div>
          <div class="tp-foot">
            <span class="tp-impact ${im.cls}"><i class="fa-solid ${im.icon}"></i>${im.label}</span>
            <span class="tp-dates">${fmtShort(m.timestamp_debut)} → ${fmtShort(m.timestamp_fin)}</span>
            <a class="tp-id" href="/helia-etat-reseau-data/intervention/${m.id}" target="_blank" title="Voir le détail de l'intervention"><i class="fa-solid fa-fingerprint"></i>${m.id}</a>
          </div>
          ${progressHtml}</div>`;
        tourActivePopup = new maplibregl.Popup({
          closeButton: false, closeOnClick: false, offset: 22,
          className: "helia-popup helia-tour-popup", maxWidth: "320px",
        }).setLngLat([gp.lon, gp.lat]).setHTML(html).addTo(map);
      }

      function tourStep() {
        if (!tourRunning || !tourItems.length) { stopTour(); return; }
        if (tourIndex >= tourItems.length) tourIndex = 0;
        stopPing();
        const { m, gp } = tourItems[tourIndex];
        const bearing   = TOUR_BEARINGS[tourIndex % TOUR_BEARINGS.length];

        if (gp && _prevTourGp) animateTourArc(_prevTourGp, gp, m.impact);

        selectMaintenance(m.id, gp.commune, true);
        startTourProgressBar(m.id);

        map.flyTo({ center:[gp.lon, gp.lat], zoom:11, pitch:50, bearing, duration:TOUR_FLY_MS, essential:true });
        setTimeout(() => { showTourPopup(m, gp); if (_ctx) animatePing(gp, m.impact); }, TOUR_FLY_MS + 100);
        _prevTourGp = gp;

        tourIndex++;
        updateTourBtn();
        tourTimeout = setTimeout(tourStep, TOUR_DELAY);
      }

      function startTour() {
        if (!displayed.length) return;
        // Liste plate : une entrée par (intervention × commune)
        tourItems   = displayed.flatMap(m => m.communes_geopoints.map(gp => ({ m, gp })));
        if (!tourItems.length) return;
        tourIndex   = 0;
        tourRunning = true;
        const c = map.getCenter();
        _prevTourGp = { lon: c.lng, lat: c.lat };
        try { _initOverlay(); _showCanvas(); } catch(e) { console.warn('Tour overlay init failed:', e); }
        // Sur mobile/tablette en paysage : réduire sidebar + plein écran automatique
        tourCollapsedSidebar = false;
        const isLandscape = window.matchMedia('(orientation: landscape)').matches;
        const isTouch     = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
        if (isLandscape && isTouch) {
          if (sidebarVisible) {
            sidebarVisible = false;
            document.querySelector("aside").classList.add("collapsed");
            document.getElementById("sidebar-chevron").className = "fa-solid fa-chevron-right";
            setTimeout(() => map.resize(), 260);
            tourCollapsedSidebar = true;
          }
          if (!document.fullscreenElement && document.documentElement.requestFullscreen) {
            document.documentElement.requestFullscreen().catch(() => {});
          }
        }
        tourStep();
      }

      function stopTour() {
        if (!tourRunning) return;
        clearTimeout(tourTimeout);
        tourTimeout = null;
        tourRunning = false;
        tourPaused = false;
        hideTourPopup();
        _hideCanvas();
        listEl.querySelectorAll(".mi.tour-active").forEach(el => el.classList.remove("tour-active"));
        map.easeTo({ pitch:0, bearing:0, duration:800 });
        updateTourBtn();
        // Restaurer la sidebar si elle avait été auto-réduite
        if (tourCollapsedSidebar) {
          sidebarVisible = true;
          document.querySelector("aside").classList.remove("collapsed");
          document.getElementById("sidebar-chevron").className = "fa-solid fa-chevron-left";
          setTimeout(() => map.resize(), 260);
          tourCollapsedSidebar = false;
        }
        // Quitter le plein écran s'il était actif
        if (document.fullscreenElement) {
          document.exitFullscreen().catch(() => {});
        }
      }

      document.getElementById("btn-tour").addEventListener("click", () => {
        if (tourRunning) stopTour(); else startTour();
      });

      // ── Swipe-down pour fermer le drawer (mobile) ────────────────────────
      let touchStartY = 0;
      detailEl.addEventListener("touchstart", (e) => { touchStartY = e.touches[0].clientY; }, { passive: true });
      detailEl.addEventListener("touchend",   (e) => { if (e.changedTouches[0].clientY - touchStartY > 60) closeDetail(); }, { passive: true });

      // ── Boutons & filtres live ───────────────────────────────────────────
      function debounce(fn, ms) { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; }
      function doFilter() { stopTour(); renderList(applyFilters(allMaintenances)); }

      document.getElementById("filter-service").addEventListener("change",  doFilter);

      document.getElementById("btn-reset").addEventListener("click", () => {
        document.getElementById("filter-service").value = "";
        renderList(allMaintenances, true);
        map.flyTo({ center:[165.8, -21.2], zoom:6.2, duration:600 });
      });

      document.getElementById("btn-geolocate").addEventListener("click", () => {
        if (!navigator.geolocation) { alert("Géolocalisation non disponible."); return; }
        navigator.geolocation.getCurrentPosition(
          ({ coords }) => {
            const nearby = allMaintenances.filter(m =>
              m.communes_geopoints.some(({ lat, lon }) => haversineKm(coords.latitude, coords.longitude, lat, lon) <= 50)
            );
            renderList(nearby);
            map.flyTo({ center:[coords.longitude, coords.latitude], zoom:9 });
          },
          () => alert("Impossible d'obtenir votre position."),
        );
      });

      // ── Init ─────────────────────────────────────────────────────────────
      renderList(allMaintenances);
    </script>
    <script is:inline>
      const _n = new Date();
      _n.setMinutes(0, 0, 0);
      _n.setHours(_n.getHours() + 1);
      const _el = document.getElementById('next-refresh');
      if (_el) _el.textContent = _n.toLocaleTimeString('fr-NC', { timeZone:'Pacific/Noumea', hour:'2-digit', minute:'2-digit' });
    </script>
  </body>
</html>

