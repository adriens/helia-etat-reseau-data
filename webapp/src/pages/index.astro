          <i class="fa-solid fa-chart-column"></i> Analytics
        </a>
        <a href="/helia-etat-reseau-data/kanban/"
           class="text-slate-400 hover:text-indigo-400 px-2 py-1 rounded border border-[#2d3148] hover:border-indigo-500 transition-colors">
          <i class="fa-solid fa-table-columns"></i> Kanban
        </a>
