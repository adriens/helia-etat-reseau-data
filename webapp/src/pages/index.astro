               class="ml-2 text-xs font-mono font-normal text-slate-500 border border-[#2d3148] rounded px-1.5 py-0.5 hover:text-violet-400 hover:border-violet-500 transition-colors">{gitTag}</a>
          )}
        </h1>
        <p class="text-xs text-slate-500">
          Construit le {builtAt} ·
          <a href={`https://github.com/adriens/helia-etat-reseau-data/commit/${commitSha}`}
             target="_blank" rel="noopener"
             class="font-mono hover:text-violet-400 transition-colors">{commitSha}</a>
          · helia.nc/etat-du-reseau
        </p>
      </div>
      <nav class="ml-auto flex gap-2 text-xs">
        <a href="/helia-etat-reseau-data/rss.xml"
           class="text-slate-400 hover:text-orange-400 px-2 py-1 rounded border border-[#2d3148] hover:border-orange-500 transition-colors">
          <i class="fa-solid fa-rss"></i> RSS
        </a>
        <a href="/helia-etat-reseau-data/calendar.ics"
           class="text-slate-400 hover:text-blue-400 px-2 py-1 rounded border border-[#2d3148] hover:border-blue-500 transition-colors">
          <i class="fa-regular fa-calendar"></i> iCal
