      .drawer-handle { display: none; width: 40px; height: 4px; background: #3d4263; border-radius: 2px; margin: -4px auto 12px; }
      #detail .close-btn { float: right; background: none; border: none; color: #64748b; cursor: pointer; font-size: 1.1rem; line-height: 1; padding: 0; }
      #detail h2 { font-size: .82rem; font-weight: 600; margin: 0 0 12px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
      .detail-id { color: #4c3f8a; font-family: monospace; font-size: .75rem; }
      .detail-impact-badge { display:inline-flex; align-items:center; gap:4px; font-size:.65rem; font-weight:700; padding:2px 8px; border-radius:20px; text-transform:uppercase; }
      .detail-impact-badge.imp-20 { background:#431407; border:1px solid #c2410c; color:#fed7aa; }
      .detail-impact-badge.imp-30 { background:#450a0a; border:1px solid #b91c1c; color:#fecaca; }
      .detail-impact-badge.imp-ad { background:#422006; border:1px solid #d97706; color:#fde68a; }
      .detail-section { margin-bottom: 12px; }
      .detail-section-title { font-size:.65rem; font-weight:600; text-transform:uppercase; letter-spacing:.06em; color:#4c3f8a; margin-bottom:6px; display:flex; align-items:center; gap:5px; }
      .detail-row { display:flex; justify-content:space-between; align-items:center; font-size:.75rem; padding:4px 0; border-bottom:1px solid #1e2235; gap:8px; }
      .detail-row:last-child { border-bottom:none; }
      .detail-label { color:#64748b; flex-shrink:0; display:flex; align-items:center; gap:5px; }
      .detail-label i { color:#4c3f8a; width:12px; text-align:center; }
      .detail-value { color:#e2e8f0; text-align:right; font-variant-numeric:tabular-nums; }
      .detail-pills { display:flex; flex-wrap:wrap; gap:4px; }
      .detail-pill { font-size:.63rem; padding:2px 7px; border-radius:5px; background:#1e2235; border:1px solid #2d3756; color:#94a3b8; }
      .detail-pill-clickable { cursor: pointer; transition: all .15s; display: inline-flex; align-items: center; gap: 4px; }
      .detail-pill-clickable:hover { border-color: #7c3aed; color: #a78bfa; background: #2d1f69; }
      .detail-pill-pop { font-size: .55rem; opacity: 0.6; font-weight: 400; }
      .detail-pill.pill-nc { background:#1a1535; border-color:#4c3f8a; color:#a78bfa; }
      .detail-pill.pill-svc { background:#13151f; border-color:#2d3756; color:#7c6aad; }
      .detail-pill.pill-province { background:#13151f; border-color:#2d3148; color:#64748b; }
      .detail-footer { font-size:.6rem; color:#374151; text-align:right; margin-top:8px; padding-top:8px; border-top:1px solid #1e2235; font-style:italic; }
      @keyframes ongoing-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .45; } }
      @keyframes ongoing-bar   { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
      @media (max-width: 700px) {
        aside { width: 100%; height: 45vh; border-right: none; border-bottom: 1px solid #2d3148; }
        aside.collapsed { width: 100% !important; height: 0 !important; }
        .layout { flex-direction: column; }
        #detail { position: fixed; bottom: 0; left: 0; right: 0; width: 100%; max-height: 75vh; border-radius: 16px 16px 0 0; border-bottom: none; transform: translateY(100%); transition: transform .3s cubic-bezier(.32,.72,0,1); display: block; pointer-events: none; padding: 12px 16px 24px; }
        #detail.visible { transform: translateY(0); pointer-events: auto; }
        #detail-backdrop.visible { display: block; }
        .drawer-handle { display: block; }
      }
    </style>
  </head>
  <body>
    <header class="flex items-center gap-3 px-4 py-2.5 bg-[#1a1d27] border-b border-[#2d3148] shrink-0">
      <div>
        <h1 class="text-sm font-semibold text-violet-400">
          Helia NC — Maintenances réseau
          {gitTag && (
            <a href={`https://github.com/adriens/helia-etat-reseau-data/releases/tag/${gitTag}`}
