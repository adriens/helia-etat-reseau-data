      .mi-dates { display: flex; align-items: center; gap: 5px; font-size: .72rem; color: #cbd5e1; font-variant-numeric: tabular-nums; margin-bottom: 5px; }
      .mi-dates i { color: #4c3f8a; width: 12px; text-align: center; }
      .mi-dates .arr { color: #374151; margin: 0 1px; }
      .mi-loc { display: flex; align-items: baseline; gap: 5px; font-size: .78rem; font-weight: 600; color: #e2e8f0; margin-bottom: 7px; line-height: 1.3; }
      .mi-loc i { color: #6d28d9; font-size: .7rem; flex-shrink: 0; margin-top: 2px; }
      .mi-loc .more { color: #64748b; font-weight: 400; font-size: .68rem; }
      .mi-sep { border: none; border-top: 1px solid #1e2235; margin: 0 12px 7px 16px; }
      .mi-svcs { display: flex; gap: 4px; flex-wrap: wrap; }
      .mi-svc { display: inline-flex; align-items: center; gap: 4px; font-size: .63rem; font-weight: 500; color: #94a3b8; background: #1e2235; border: 1px solid #2d3756; border-radius: 5px; padding: 2px 7px; }
      .mi-svc i { font-size: .6rem; color: #4c3f8a; }
      .mi-svc.toute-nc { background:#1a1535; border-color:#4c3f8a; color:#a78bfa; }
      .mi-svc.toute-nc i { color:#a78bfa; }
      .empty-state { margin: 24px 6px; padding: 24px 16px; text-align: center; color: #64748b; font-size: .82rem; border: 1px dashed #2d3148; border-radius: 8px; }
      .shortcuts { padding: 10px 12px; border-top: 1px solid #2d3148; flex-shrink: 0; }
      .shortcuts-title { font-size: .65rem; color: #475569; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 7px; }
      .shortcuts-grid { display: grid; grid-template-columns: auto 1fr; gap: 4px 8px; align-items: center; }
      .shortcuts-grid kbd { font-family: system-ui,monospace; font-size: .65rem; font-weight: 700; background: #1e2235; border: 1px solid #3d4263; color: #94a3b8; padding: 1px 6px; border-radius: 4px; white-space: nowrap; box-shadow: 0 1px 0 #131723; text-align: center; }
      .shortcuts-grid span { font-size: .68rem; color: #64748b; }
      #map { flex: 1; position: relative; touch-action: none; }
      #btn-fit, #btn-sidebar, #btn-fullscreen { position: absolute; left: 10px; z-index: 5; background: #1a1d27cc; border: 1px solid #2d3148; color: #94a3b8; border-radius: 6px; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: .78rem; transition: background .15s, color .15s; backdrop-filter: blur(4px); }
      #btn-fit        { top: 10px; }
      #btn-sidebar    { top: 48px; }
      #btn-fullscreen { top: 86px; }
      #btn-fit:hover, #btn-sidebar:hover, #btn-fullscreen:hover { background: #2d3148; color: #a78bfa; }
      #btn-fullscreen.active { color: #a78bfa; border-color: #6d28d9; background: #1a1535cc; }
      #tour-playpause-flash { position: fixed; inset: 0; z-index: 9999; pointer-events: none; display: flex; align-items: center; justify-content: center; }
      #tour-playpause-flash .ppf-ring { width: 35vmin; height: 35vmin; border-radius: 50%; background: rgba(0,0,0,.65); border: 3px solid rgba(255,255,255,.35); display: flex; align-items: center; justify-content: center; backdrop-filter: blur(8px); }
      #tour-playpause-flash .ppf-ring i { font-size: 12vmin; color: #fff; }
      @keyframes ppf-in  { 0% { opacity:0; transform:scale(.7); } 15% { opacity:1; transform:scale(1.08); } 30% { transform:scale(1); } 100% { opacity:1; transform:scale(1); } }
      @keyframes ppf-out { 0% { opacity:1; } 100% { opacity:0; } }
      #tour-playpause-flash.show .ppf-ring { animation: ppf-in  .18s ease forwards; }
      #tour-playpause-flash.hide .ppf-ring { animation: ppf-out .35s ease forwards; }
      #detail-backdrop { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 9; }
      #detail { position: absolute; bottom: 24px; right: 16px; width: 320px; background: #1a1d27; border: 1px solid #2d3148; border-radius: 10px; padding: 16px; z-index: 10; display: none; max-height: 60vh; overflow-y: auto; }
