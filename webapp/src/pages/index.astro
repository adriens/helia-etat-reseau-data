    <div class="layout">
      <aside>
        <div class="filters">
          <div>
            <label for="filter-service">Service</label>
            <select id="filter-service">
              <option value="">Tous les services</option>
              <option value="TELEPHONIE_FIXE">Téléphonie fixe</option>
              <option value="TELEPHONIE_MOBILE">Téléphonie mobile</option>
              <option value="INTERNET_FIXE">Internet fixe</option>
              <option value="INTERNET_MOBILE">Internet mobile</option>
              <option value="RESEAU_CUIVRE">Réseau cuivre</option>
              <option value="FIBRE_OPTIQUE">Fibre optique</option>
            </select>
          </div>
          <button class="btn btn-secondary" id="btn-geolocate"><i class="fa-solid fa-location-crosshairs"></i> Me localiser (50 km)</button>
          <button class="btn btn-secondary" id="btn-reset">Tout afficher</button>
          <button class="btn btn-tour" id="btn-tour"><i class="fa-solid fa-route"></i> Tour des maintenances</button>
        </div>
        <div class="list-header">
          Maintenances <span class="count-badge" id="count">0</span>
        </div>
